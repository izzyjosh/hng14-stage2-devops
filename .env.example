# Redis Configuration
# Docker image for Redis service
REDIS_IMAGE=redis:7

# Redis connection details (internal to Docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
# Port exposed on the host machine
API_PORT=8000

# Internal port inside the API container
API_INTERNAL_PORT=8000

# Frontend Configuration
# Port exposed on the host machine
FRONTEND_PORT=3000

# Internal port inside the frontend container
FRONTEND_INTERNAL_PORT=3000

# Frontend API Connection
# URL used by frontend to communicate with the API service
# Use 'http://api:8000' for Docker environments (service name resolution)
# Use 'http://localhost:8000' for local development without Docker
API_URL=http://api:8000

# Docker Compose network name
COMPOSE_NETWORK_NAME=job-queue-network
